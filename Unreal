// --- Data model for a single score entry ---
USTRUCT(BlueprintType)
struct FScoreEntry
{
    GENERATED_BODY()

    UPROPERTY()
    FString Wallet;

    UPROPERTY()
    int64 Score;

    UPROPERTY()
    TMap<FString, int32> Meta;
};

// --- Component: in-memory queue + persistent log ---
UCLASS(ClassGroup=(Custom), meta=(BlueprintSpawnableComponent))
class YOURGAME_API UScoreQueueComponent : public UActorComponent
{
    GENERATED_BODY()

public:
    void Enqueue(const FScoreEntry& Entry)
    {
        Pending.Add(Entry);
        FString Line = FDateTime::UtcNow().ToString() + TEXT(" ") + Entry.Wallet + TEXT(" → ") + FString::FromInt(Entry.Score) + TEXT(" pts\n");
        FFileHelper::SaveStringToFile(Line, *GetLogPath(), FFileHelper::EEncodingOptions::AutoDetect, &IFileManager::Get(), EFileWrite::FILEWRITE_Append);
    }

    int32 GetPendingCount() const { return Pending.Num(); }

    TArray<FScoreEntry> DequeueAll()
    {
        TArray<FScoreEntry> Batch = Pending;
        Pending.Empty();
        return Batch;
    }

private:
    // Where to store the log
    FString GetLogPath() const
    {
        return FPaths::ProjectSavedDir() / TEXT("scores.log");
    }

    // Pending queue
    TArray<FScoreEntry> Pending;
};

// --- Actor: manages queuing, batching, HTTP flush ---
UCLASS()
class YOURGAME_API AScoreManager : public AActor
{
    GENERATED_BODY()

public:
    AScoreManager();

    // Record a single score entry
    UFUNCTION(BlueprintCallable, Category="Score Upload")
    void RecordScore(const FString& WalletAddress, int64 Score, const TMap<FString,int32>& AdditionalData);

protected:
    virtual void BeginPlay() override;
    virtual void EndPlay(const EEndPlayReason::Type EndPlayReason) override;

private:
    // Batch size trigger
    UPROPERTY(EditAnywhere, Category="Batch")
    int32 BatchSize = 50;

    // Flush interval (seconds)
    UPROPERTY(EditAnywhere, Category="Batch")
    float FlushInterval = 60.0f;

    // Endpoint URL
    UPROPERTY(EditAnywhere, Category="Config")
    FString ApiUrl = TEXT("https://studio-backend.com/postMatchResults");

    // Components
    UPROPERTY()
    UScoreQueueComponent* QueueComp;

    // Timer handle for periodic flush
    FTimerHandle TimerHandle;

    // Flush now
    void FlushNow();
    void PeriodicFlush();

    // HTTP callback
    void OnResponseReceived(FHttpRequestPtr Request, FHttpResponsePtr Response, bool bWasSuccessful);
};


// ScoreManagerUnreal.cpp
#include "ScoreManagerUnreal.h"
#include "TimerManager.h"
#include "Misc/FileHelper.h"
#include "Misc/Paths.h"

AScoreManager::AScoreManager()
{
    PrimaryActorTick.bCanEverTick = false;
    QueueComp = CreateDefaultSubobject<UScoreQueueComponent>(TEXT("ScoreQueue"));
}

void AScoreManager::BeginPlay()
{
    Super::BeginPlay();
    // Start periodic flush
    GetWorldTimerManager().SetTimer(TimerHandle, this, &AScoreManager::PeriodicFlush, FlushInterval, true);
}

void AScoreManager::EndPlay(const EEndPlayReason::Type EndPlayReason)
{
    FlushNow();
    GetWorldTimerManager().ClearTimer(TimerHandle);
    Super::EndPlay(EndPlayReason);
}

void AScoreManager::RecordScore(const FString& WalletAddress, int64 Score, const TMap<FString,int32>& AdditionalData)
{
    FScoreEntry Entry;
    Entry.Wallet = WalletAddress;
    Entry.Score = Score;
    Entry.Meta = AdditionalData;

    QueueComp->Enqueue(Entry);
    UE_LOG(LogTemp, Log, TEXT("Enqueued score: %s → %lld pts"), *WalletAddress, Score);

    if (QueueComp->GetPendingCount() >= BatchSize)
    {
        FlushNow();
    }
}

void AScoreManager::PeriodicFlush()
{
    if (QueueComp->GetPendingCount() > 0)
    {
        FlushNow();
    }
}

void AScoreManager::FlushNow()
{
    TArray<FScoreEntry> Batch = QueueComp->DequeueAll();
    if (Batch.Num() == 0) return;

    // Build JSON
    TSharedPtr<FJsonObject> JsonRoot = MakeShareable(new FJsonObject);
    TArray<TSharedPtr<FJsonValue>> JsonWallets;
    TArray<TSharedPtr<FJsonValue>> JsonScores;
    TArray<TSharedPtr<FJsonValue>> JsonKeysArr;
    TArray<TSharedPtr<FJsonValue>> JsonValsArr;

    // Prepare 2D arrays
    TArray<TArray<TSharedPtr<FJsonValue>>> Keys2D;
    TArray<TArray<TSharedPtr<FJsonValue>>> Vals2D;

    for (auto& E : Batch)
    {
        JsonWallets.Add(MakeShareable(new FJsonValueString(E.Wallet)));
        JsonScores.Add( MakeShareable(new FJsonValueNumber((double)E.Score)) );

        // Inner arrays
        TArray<TSharedPtr<FJsonValue>> KeysInner;
        TArray<TSharedPtr<FJsonValue>> ValsInner;
        for (auto& Pair : E.Meta)
        {
            KeysInner.Add(MakeShareable(new FJsonValueString(Pair.Key)));
            ValsInner.Add(MakeShareable(new FJsonValueNumber(Pair.Value)));
        }
        Keys2D.Add(KeysInner);
        Vals2D.Add(ValsInner);
    }

    // Serialize 2D arrays
    TArray<TSharedPtr<FJsonValue>> KeysOuter;
    TArray<TSharedPtr<FJsonValue>> ValsOuter;
    for (int32 i = 0; i < Keys2D.Num(); i++)
    {
        KeysOuter.Add( MakeShareable(new FJsonValueArray(Keys2D[i])) );
        ValsOuter.Add( MakeShareable(new FJsonValueArray(Vals2D[i])) );
    }

    JsonRoot->SetArrayField(TEXT("wallets"), JsonWallets);
    JsonRoot->SetArrayField(TEXT("scores"), JsonScores);
    JsonRoot->SetArrayField(TEXT("keys"), KeysOuter);
    JsonRoot->SetArrayField(TEXT("values"), ValsOuter);

    // Convert to string
    FString Output;
    TSharedRef<TJsonWriter<>> Writer = TJsonWriterFactory<>::Create(&Output);
    FJsonSerializer::Serialize(JsonRoot.ToSharedRef(), Writer);

    // Create and send request
    TSharedRef<IHttpRequest, ESPMode::ThreadSafe> Request = FHttpModule::Get().CreateRequest();
    Request->SetURL(ApiUrl);
    Request->SetVerb(TEXT("POST"));
    Request->SetHeader(TEXT("Content-Type"), TEXT("application/json"));
    Request->SetContentAsString(Output);
    Request->OnProcessRequestComplete().BindUObject(this, &AScoreManager::OnResponseReceived);
    Request->ProcessRequest();

    UE_LOG(LogTemp, Log, TEXT("Flushing %d scores to API"), Batch.Num());
}

void AScoreManager::OnResponseReceived(FHttpRequestPtr Request, FHttpResponsePtr Response, bool bWasSuccessful)
{
    if (bWasSuccessful && Response.IsValid() && Response->GetResponseCode() == 200)
    {
        UE_LOG(LogTemp, Log, TEXT("✅ Batch submission succeeded: %s"), *Response->GetContentAsString());
    }
    else
    {
        UE_LOG(LogTemp, Error, TEXT("❌ Batch submission failed: HTTP %d"), Response.IsValid() ? Response->GetResponseCode() : -1);
        if (Response.IsValid())
        {
            UE_LOG(LogTemp, Error, TEXT("Server: %s"), *Response->GetContentAsString());
        }
    }
}
